        <mxCell id="pg4_err" value="State=ORD-MA-4&#xa;Message=상대호가가 없습니다&#xa;PUB IPCERR(MARKET)&#xa;return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" parent="pg4_1" vertex="1">
