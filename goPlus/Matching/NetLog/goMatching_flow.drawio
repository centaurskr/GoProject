  <diagram name="limitMatching" id="oXZdWEwyO0H7zzwh3PEt">
    <mxGraphModel dx="1415" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="pg2_0" />
        <mxCell id="pg2_1" parent="pg2_0" />
        <mxCell id="pg2_t" value="limitMatching() — 지정가 매칭 내부 루프 상세" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;" parent="pg2_1" vertex="1">
          <mxGeometry x="108" y="10" width="600" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg2_s" value="START&#xa;limitMatching(ipcpub, memcoin, makerMode, taker)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="pg2_1" vertex="1">
          <mxGeometry x="224" y="46" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pg2_setup" value="makerHoga = memcoin.Mesu  (makerMode==MESU)&#xa;             memcoin.Medo  (makerMode==MEDO)&#xa;sortFlag = 0,  takerIsZero = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="274" y="116" width="280" height="62" as="geometry" />
        </mxCell>
        <mxCell id="pg2_obox" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;[ Outer Loop : for idx := range makerHoga ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;arcSize=5;align=left;" parent="pg2_1" vertex="1">
          <mxGeometry x="20" y="307" width="750" height="1703" as="geometry" />
        </mxCell>
        <mxCell id="pg2_mhoga" value="mHoga = &amp;makerHoga[idx]&#xa;mHoga.InWindow()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="274" y="194" width="280" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pg2_prc" value="prcComp = Compare(mHoga.Price, taker.Price)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="274" y="258" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pg2_pchk" value="가격 조건 실패?&#xa;MEDO maker: prcComp==1&#xa;MESU maker: prcComp==-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="289" y="314" width="250" height="78" as="geometry" />
        </mxCell>
        <mxCell id="pg2_cnt" value="cnt = mHoga.OrderCount&#xa;(루프 중 변경되므로 고정값 사용)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="274" y="414" width="280" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pg2_ibox" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;[ Inner Loop : for i := 0; i &amp;lt; cnt; i++ ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;strokeWidth=3;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;arcSize=4;align=left;" parent="pg2_1" vertex="1">
          <mxGeometry x="30" y="478" width="710" height="1162" as="geometry" />
        </mxCell>
        <mxCell id="pg2_mkr" value="maker, _ = mHoga.GetOrdPointerByIndex(i)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="274" y="507" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pg2_maxchk" value="maker.OrdNum == ORDSEQ_MAX?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="289" y="561" width="250" height="68" as="geometry" />
        </mxCell>
        <mxCell id="pg2_remcp" value="remcp = Compare(maker.RemQty, taker.RemQty)&#xa;cheqty = calcCheQty(maker, taker, remcp)&#xa;maker.CheSeq++,  taker.CheSeq++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="274" y="654" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pg2_ipcche" value="PUB -&gt; InnerProxy  topic: IPCCHE&#xa;[ pairkey(Snowflake) | chetime(UnixMicro) | cheqty | maker* | taker* ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="224" y="734" width="380" height="52" as="geometry" />
        </mxCell>
        <mxCell id="pg2_upd" value="BfPrice = maker.Price,  BfTime = chetime&#xa;mHoga.SubSumQty(cheqty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="274" y="802" width="280" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pg2_rchk" value="remcp != 1?&#xa;(maker.RemQty &lt;= taker.RemQty)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="289" y="868" width="250" height="72" as="geometry" />
        </mxCell>
        <mxCell id="pg2_mclr" value="maker.OrdNum = ORDSEQ_MAX&#xa;maker.Margin = 0,  maker.Fee = 0&#xa;mHoga.DecOrderCount()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=4;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="90" y="935" width="220" height="62" as="geometry" />
        </mxCell>
        <mxCell id="pg2_occhk" value="OrderCount == 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="98" y="1017" width="205" height="62" as="geometry" />
        </mxCell>
        <mxCell id="pg2_spc" value="SetPrice(MAX_PRICE) MEDO&#xa;SetPrice(MIN_PRICE) MESU&#xa;sortFlag |= SORT_HOGA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=4;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="90" y="1103" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="pg2_soflag" value="sortFlag |= SORT_ORDER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="108" y="1186" width="185" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_mfee" value="maker 잔량 있음 (maker &gt; taker)&#xa;mg = maker.Price x cheqty&#xa;fe = mg x MAX(MakeRate, TakeRate)&#xa;maker.Margin -= mg&#xa;maker.Fee    -= fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=4;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="482" y="965" width="208" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg2_mrg" value="합류" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="pg2_1" vertex="1">
          <mxGeometry x="337" y="1222" width="70" height="34" as="geometry" />
        </mxCell>
        <mxCell id="pg2_tchk" value="remcp != -1?&#xa;(maker.RemQty &gt;= taker.RemQty)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="247" y="1300" width="250" height="72" as="geometry" />
        </mxCell>
        <mxCell id="pg2_tiz" value="takerIsZero = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="535" y="1317" width="150" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_ibrk" value="break inner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="545" y="1371" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="pg2_tbchk" value="taker.BuySell == B?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="247" y="1396" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pg2_tfee" value="taker 증거금 차감 (매수 taker):&#xa;mg = taker.Price x cheqty&#xa;fe = mg x MAX(MakeRate, TakeRate)&#xa;taker.Margin -= mg,  taker.Fee -= fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=4;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="262" y="1484" width="220" height="72" as="geometry" />
        </mxCell>
        <mxCell id="pg2_nxti" value="i++ (inner loop 다음 반복)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=3;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="202" y="1582" width="340" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_iend" value="Inner Loop 종료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="261" y="1650" width="180" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_sochk" value="SORT_ORDER &amp;&amp; count &gt; 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="221" y="1702" width="260" height="68" as="geometry" />
        </mxCell>
        <mxCell id="pg2_sord" value="mHoga.SortOrder()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="600" y="1718" width="140" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_tizchk" value="takerIsZero == true?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="221" y="1803" width="260" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pg2_obrk" value="break outer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="574" y="1818.5" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="pg2_soclr" value="sortFlag &amp;^= SORT_ORDER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="231" y="1893" width="240" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_nxto" value="idx++ (outer loop 다음 반복)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=3;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="181" y="1952" width="340" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_oend" value="Outer Loop 종료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=11;" parent="pg2_1" vertex="1">
          <mxGeometry x="260" y="2030" width="180" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg2_shchk" value="sortFlag &amp; SORT_HOGA?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg2_1" vertex="1">
