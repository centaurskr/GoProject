        <mxCell id="pg4_smkd" value="jsonpk.Margin = taker.RemQty&#xa;PUB IPCMKDONE(MARKET)&#xa;→ gofAfterFunction wallet 반환" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;" parent="pg4_1" vertex="1">
