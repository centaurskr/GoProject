        <mxCell id="pg4_bzero" value="takerIsZero == false?&#xa;(잔여 증거금 있음)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg4_1" vertex="1">
          <mxGeometry x="495.5" y="628" width="239" height="68" as="geometry" />
