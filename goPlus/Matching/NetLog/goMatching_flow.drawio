  <diagram name="cancelOrder" id="BuTPA89GgqzAN2Q7NLtm">
    <mxGraphModel dx="2052" dy="1151" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="pg3_0" />
        <mxCell id="pg3_1" parent="pg3_0" />
        <mxCell id="pg3_t" value="cancelOrder() — 취소 주문 처리" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;" parent="pg3_1" vertex="1">
          <mxGeometry x="134" y="30" width="500" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg3_s" value="START&#xa;cancelOrder(ipcpub, memcoin, inner, jsonpk)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="pg3_1" vertex="1">
          <mxGeometry x="214" y="100" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pg3_init" value="cordp = &amp;inner.MemData&#xa;mode = MEDO (BuySell==S) / MESU (BuySell==B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="264" y="166" width="280" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pg3_lb1" value="Step 1: 호가 찾기" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" parent="pg3_1" vertex="1">
          <mxGeometry x="134" y="226" width="100" height="22" as="geometry" />
        </mxCell>
        <mxCell id="pg3_fhoga" value="orgHoga = memcoin.FindHoga(mode, cordp.Price)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg3_1" vertex="1">
          <mxGeometry x="264" y="226" width="280" height="38" as="geometry" />
        </mxCell>
        <mxCell id="pg3_hnil" value="orgHoga == nil?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg3_1" vertex="1">
          <mxGeometry x="300" y="278" width="208" height="38" as="geometry" />
        </mxCell>
        <mxCell id="pg3_err1" value="State=ORD-MA-1&#xa;Message=원주문 호가 없음&#xa;PUB IPCERR(CANCEL)&#xa;return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="574" y="264" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg3_iwin" value="saveWindow = orgHoga.IsWindow&#xa;if !saveWindow: orgHoga.InWindow()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="264" y="334" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="pg3_lb2" value="Step 2: 원주문 찾기" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" parent="pg3_1" vertex="1">
          <mxGeometry x="134" y="396" width="120" height="22" as="geometry" />
        </mxCell>
        <mxCell id="pg3_find" value="for i := 0; i &lt; orgHoga.Hd.OrderCount; i++ {&#xa;  op, _ = orgHoga.GetOrdPointerByIndex(i)&#xa;  if op.OrdNum == inner.OrgNum { orgp=op; break }&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="264" y="396" width="280" height="68" as="geometry" />
        </mxCell>
        <mxCell id="pg3_pnil" value="orgp == nil?&#xa;(원주문 없음)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg3_1" vertex="1">
          <mxGeometry x="300" y="486" width="208" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pg3_err2" value="State=ORD-MA-2&#xa;Message=원주문번호 없음&#xa;if !saveWindow: OutWindow()&#xa;PUB IPCERR(CANCEL)&#xa;return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="582" y="468.5" width="172" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pg3_uidchk" value="orgp.UserId != uid?&#xa;(주문자 불일치)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg3_1" vertex="1">
          <mxGeometry x="300" y="556" width="208" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pg3_err3" value="State=ORD-MA-3&#xa;Message=UserId 불일치&#xa;PUB IPCERR(CANCEL)&#xa;return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="582" y="546" width="172" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg3_lb3" value="Step 3: 취소 처리" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" parent="pg3_1" vertex="1">
          <mxGeometry x="134" y="616" width="110" height="22" as="geometry" />
        </mxCell>
        <mxCell id="pg3_set" value="jsonpk.Margin = orgp.Margin (증거금 해소용)&#xa;jsonpk.Fee    = orgp.Fee&#xa;jsonpk.Qty    = orgp.RemQty (취소 수량)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="264" y="626" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pg3_dec" value="orgHoga.DecOrderCount()&#xa;orgHoga.SubSumQty(orgp.RemQty)&#xa;orgp.OrdNum = ORDSEQ_MAX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="pg3_1" vertex="1">
          <mxGeometry x="264" y="706" width="280" height="58" as="geometry" />
        </mxCell>
        <mxCell id="pg3_occhk" value="OrderCount &gt; 0?&#xa;(남은 주문 있음)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg3_1" vertex="1">
          <mxGeometry x="300" y="782" width="208" height="44" as="geometry" />
        </mxCell>
        <mxCell id="pg3_sorto" value="orgHoga.SortOrder()&#xa;주문번호 오름차순" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg3_1" vertex="1">
          <mxGeometry x="74" y="781" width="190" height="45" as="geometry" />
        </mxCell>
        <mxCell id="pg3_seth" value="SetPrice(MAX_PRICE) MEDO&#xa;SetPrice(MIN_PRICE) MESU&#xa;memcoin.SortHoga(mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=4;" parent="pg3_1" vertex="1">
          <mxGeometry x="582" y="776.5" width="172" height="55" as="geometry" />
        </mxCell>
        <mxCell id="pg3_owin" value="if !saveWindow: orgHoga.OutWindow()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg3_1" vertex="1">
