        <mxCell id="pg4_bmtch" value="marketMatching(ipcpub, memcoin,&#xa;  makerMode=MEDO, taker)&#xa;상세: marketMatching 페이지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" parent="pg4_1" vertex="1">
