  <diagram name="marketMatching" id="AXq5GgEsdmO5RJnwSfTa">
    <mxGraphModel dx="1466" dy="822" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="pg5_0" />
        <mxCell id="pg5_1" parent="pg5_0" />
        <mxCell id="pg5_t" value="marketMatching() — 시장가 매칭 루프 (limitMatching 차이점 강조)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=20;" parent="pg5_1" vertex="1">
          <mxGeometry x="34" y="10" width="776" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pg5_diff" value="limitMatching 과의 주요 차이점&#xa;[1] 가격 비교 없음. MAX/MIN_PRICE sentinel 로 루프 종료&#xa;[2] 매수(B) taker: 매 MEMHOGA 마다 RemQty 재계산&#xa;    qty = (Margin+Fee) / ((1+TakeRate) x mHoga.Price)&#xa;[3] taker.Price = mHoga.Price  (시장가는 maker 가격 사용)&#xa;[4] 종료 조건: Margin==0 AND Fee==0 → takerIsZero=true" style="text;html=1;strokeColor=#d79b00;fillColor=#fff2cc;align=left;spacingLeft=8;fontSize=11;rounded=1;fontStyle=1;" parent="pg5_1" vertex="1">
          <mxGeometry x="410" y="2040" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg5_s" value="START&#xa;marketMatching(ipcpub, memcoin, makerMode, taker)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="pg5_1" vertex="1">
          <mxGeometry x="260" y="70" width="380" height="47" as="geometry" />
        </mxCell>
        <mxCell id="pg5_setup" value="makerHoga = memcoin.Mesu / Medo  (makerMode 기준)&#xa;sortFlag = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="140" width="285" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pg5_obox" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; [ Outer Loop : for idx := range makerHoga ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;arcSize=4;align=left;" parent="pg5_1" vertex="1">
          <mxGeometry x="10" y="200" width="780" height="1590" as="geometry" />
        </mxCell>
        <mxCell id="pg5_mhoga" value="mHoga = &amp;makerHoga[idx]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="220" width="285" height="38" as="geometry" />
        </mxCell>
        <mxCell id="pg5_sent" value="[1] mHoga.Price == MAX_PRICE OR MIN_PRICE?&#xa;(limitMatching 과 차이: 가격 비교 아님)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="300" y="280" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="pg5_iwin" value="mHoga.InWindow()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="390" width="285" height="38" as="geometry" />
        </mxCell>
        <mxCell id="pg5_ibox" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;[ Inner Loop : for i := 0; i &amp;lt; cnt; i++ ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;dashed=1;verticalAlign=top;fontStyle=1;fontSize=11;arcSize=3;align=left;" parent="pg5_1" vertex="1">
          <mxGeometry x="50" y="450" width="720" height="1320" as="geometry" />
        </mxCell>
        <mxCell id="pg5_bchk" value="[2] taker.BuySell == B?&#xa;(매수 시장가: RemQty 재계산)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="310" y="460" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pg5_qty" value="[2] RemQty 계산:&#xa;margin = taker.Margin + taker.Fee&#xa;unit   = (1 + TakeRate) x mHoga.Price&#xa;remQty = margin / unit  (버림)&#xa;정규화: remQty -= (remQty % MinTrade)&#xa;taker.RemQty = remQty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=4;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="88" y="535" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg5_rzchk" value="taker.RemQty == 0?&#xa;(최소수량 미달)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="75" y="660" width="195" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pg5_rzbrk" value="break outer&#xa;(최소수량 미달)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="100" y="760" width="145" height="38" as="geometry" />
        </mxCell>
        <mxCell id="pg5_tprc" value="[3] taker.Price = mHoga.Price  (시장가: maker 가격 사용)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="674.5" width="285" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg5_cnt" value="cnt = mHoga.OrderCount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="740" width="285" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg5_mkr" value="maker, _ = mHoga.GetOrdPointerByIndex(i)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="798" width="285" height="38" as="geometry" />
        </mxCell>
        <mxCell id="pg5_maxchk" value="maker.OrdNum == ORDSEQ_MAX?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="310" y="860" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pg5_remcp" value="remcp = Compare(maker.RemQty, taker.RemQty)&#xa;cheqty = calcCheQty(maker, taker, remcp)&#xa;maker.CheSeq++,  taker.CheSeq++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="940" width="285" height="62" as="geometry" />
        </mxCell>
        <mxCell id="pg5_ipcche" value="PUB -&gt; InnerProxy  topic: IPCCHE&#xa;[ pairkey | chetime | cheqty | maker* | taker* ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="1020" width="285" height="48" as="geometry" />
        </mxCell>
        <mxCell id="pg5_upd" value="BfPrice = maker.Price,  BfTime = chetime&#xa;mHoga.SubSumQty(cheqty)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="307.5" y="1080" width="285" height="45" as="geometry" />
        </mxCell>
        <mxCell id="pg5_swrem" value="switch remcp:" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="385" y="1140" width="130" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg5_c01" value="case -1 / 0 (maker &lt;= taker):&#xa;maker.OrdNum = ORDSEQ_MAX&#xa;if maker.BuySell==B:&#xa;  maker.Margin=0, maker.Fee=0&#xa;mHoga.DecOrderCount()&#xa;if count==0: SetPrice(MAX/MIN)&#xa;sortFlag |= SORT_ORDER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=4;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="88" y="1190" width="240" height="115" as="geometry" />
        </mxCell>
        <mxCell id="pg5_c1" value="case 1 (maker &gt; taker):&#xa;if maker.BuySell==B:&#xa;  mg = maker.Price x cheqty&#xa;  fe = mg x MAX(Rate)&#xa;  maker.Margin -= mg&#xa;  maker.Fee    -= fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=4;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="520" y="1190" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg5_tkfee" value="taker 증거금 차감 (taker.BuySell==B 인 경우):&#xa;mg = taker.Price x cheqty&#xa;fe = mg x taker.TakeRate&#xa;taker.Margin -= mg,  taker.Fee -= fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=4;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="271" y="1320" width="285" height="72" as="geometry" />
        </mxCell>
        <mxCell id="pg5_rbchk" value="remcp != -1?&#xa;(매칭 종료)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="75" y="1420" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="pg5_ibrk" value="break inner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="450" y="1434.5" width="130" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pg5_nxti" value="i++ (inner loop 다음 반복)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=3;fontSize=11;" parent="pg5_1" vertex="1">
          <mxGeometry x="72.5" y="1510" width="285" height="36" as="geometry" />
