        <mxCell id="pg1_b_cmp" value="cmp = Compare(Medo[0].Price, taker.Price)&#xa;매도 1호가 vs 매수 주문가&#xa; 1 : 매도1호가 &gt; 매수가 → 신규등록&#xa;≤0 : 매도1호가 ≤ 매수가 → 매칭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" parent="pg1_1" vertex="1">
          <mxGeometry x="510" y="360" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg1_b_chk" value="cmp == 1?&#xa;(매도1호가 &gt; 매수가)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg1_1" vertex="1">
          <mxGeometry x="551.25" y="480" width="157.5" height="72" as="geometry" />
        </mxCell>
        <mxCell id="pg1_b_new" value="addNewHoga(MESU, taker)&#xa;신규 매수 호가 등록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="pg1_1" vertex="1">
          <mxGeometry x="650" y="608" width="140" height="63" as="geometry" />
        </mxCell>
        <mxCell id="pg1_b_mtch" value="limitMatching(ipcpub, memcoin,&lt;br&gt;  makerMode=&lt;font style=&quot;color: rgb(233, 25, 12);&quot;&gt;MEDO&lt;/font&gt;, taker)&lt;br&gt;상세: limitMatching 페이지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" parent="pg1_1" vertex="1">
          <mxGeometry x="460" y="608.5" width="165" height="62" as="geometry" />
        </mxCell>
        <mxCell id="pg1_b_zero" value="takerIsZero == false?&#xa;(잔량 있음)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="pg1_1" vertex="1">
          <mxGeometry x="510" y="720" width="170" height="68" as="geometry" />
        </mxCell>
        <mxCell id="pg1_b_add" value="addNewHoga(MESU, taker)&#xa;잔량 매수 호가 등록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="pg1_1" vertex="1">
          <mxGeometry x="497.5" y="858" width="195" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pg1_note" value="지정가 매칭 조건&#xa;매도: 매수1호가 &gt;= taker.Price 이면 매칭&#xa;매수: 매도1호가 &lt;= taker.Price 이면 매칭&#xa;매칭 후 잔량 있으면 호가에 신규 등록" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;spacingLeft=6;fontSize=10;rounded=1;" parent="pg1_1" vertex="1">
          <mxGeometry x="35" y="121.5" width="235" height="65" as="geometry" />
        </mxCell>
